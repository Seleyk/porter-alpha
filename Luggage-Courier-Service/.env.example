# ─── API Server (Railway) ────────────────────────────────────────────────────
PORT=8080

# PostgreSQL — get this from Neon (neon.tech) or Railway Postgres add-on
DATABASE_URL=postgresql://user:password@host:5432/dbname

# The public URL of your deployed API server (no trailing slash)
APP_URL=https://your-api.up.railway.app

# ─── Stripe (optional for test — skip to use /api/payments/dev-bypass) ───────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Get this from Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Auth: OTP delivery (at least one required for login) ────────────────────
# Twilio — for SMS OTP
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+15551234567

# Resend — for email OTP (alternative to Twilio)
RESEND_API_KEY=re_...

# ─── Google / Apple OAuth (optional — OTP login works without these) ─────────
GOOGLE_CLIENT_ID=your_google_client_id

# ─── Photo uploads (optional — skip for basic test) ──────────────────────────
# JSON string of a GCS service account key
GOOGLE_CLOUD_KEY_JSON={"type":"service_account","project_id":"..."}
# Path inside your GCS bucket, e.g. /my-bucket/porter-uploads
PRIVATE_OBJECT_DIR=/your-bucket/porter-uploads

# ─── Frontend (Vercel) ────────────────────────────────────────────────────────
# Set these in Vercel project settings → Environment Variables
# EXPO_PUBLIC_DOMAIN=your-api.up.railway.app   (no https://, just the host)
# EXPO_PUBLIC_MAPBOX_TOKEN=pk.eyJ1...           (from mapbox.com)
